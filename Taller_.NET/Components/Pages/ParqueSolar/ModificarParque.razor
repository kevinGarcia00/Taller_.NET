@page "/parques/modificar/{IdParque:int}"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using FluentValidation
@using Taller_.NET.Modulos.ParqueSolar.Domain.Excepciones
@inject IParqueService ParqueService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Modificar Parque Solar</PageTitle>

<h1>Modificar Parque Solar</h1>

<AuthorizeView Roles="Administrador" Context="autorizacion">
    <Authorized>
        @if (_cargando)
        {
            <RadzenText TextStyle="TextStyle.Body2">Cargando el parque solar...</RadzenText>
        }
        else if (!_parqueEncontrado)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Title="Parque no encontrado">
                No se encontro el parque solar solicitado.
            </RadzenAlert>
        }
        else
        {
            <RadzenCard>
                <RadzenTemplateForm TItem="ModificarParqueDto" Data="@_modelo" Submit="OnValidSubmit">
                    <RadzenStack Gap="1rem">
                        <RadzenFormField Text="Nombre" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_modelo.Nombre" MaxLength="@Parque.LongitudMaximaNombre" />
                        </RadzenFormField>

                        <RadzenFormField Text="Ubicacion" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_modelo.Ubicacion" MaxLength="@Parque.LongitudMaximaUbicacion" />
                        </RadzenFormField>

                        <RadzenFormField Text="Cantidad maxima de nodos" Variant="Variant.Outlined">
                            <RadzenNumeric @bind-Value="_modelo.CantMaxNodos" Min="1" />
                        </RadzenFormField>

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Text="Guardar cambios" ButtonType="ButtonType.Submit" Icon="save" />
                            <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Secondary" Icon="close"
                                          Click="@(() => NavigationManager.NavigateTo("/parques"))" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenCard>
        }
    </Authorized>
    <NotAuthorized>
        <RadzenAlert AlertStyle="AlertStyle.Warning" Title="Acceso restringido">
            Solo los usuarios con el rol de Administrador pueden modificar parques solares.
        </RadzenAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public int IdParque { get; set; }

    private ModificarParqueDto _modelo = new();
    private bool _parqueEncontrado;
    private bool _cargando = true;

    protected override void OnParametersSet()
    {
        _cargando = true;
        _parqueEncontrado = false;
        _modelo = new ModificarParqueDto();

        try
        {
            var parque = ParqueService.ObtenerParqueSync(IdParque);

            _modelo = new ModificarParqueDto
            {
                Nombre = parque.Nombre,
                Ubicacion = parque.Ubicacion,
                CantMaxNodos = parque.CantMaxNodos
            };

            _parqueEncontrado = true;
        }
        catch (System.Exception excepcion)
        {
            NotificarError(excepcion.Message);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task OnValidSubmit()
    {
        try
        {
            await ParqueService.ModificarParqueAsync(IdParque, _modelo);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Parque modificado",
                Detail = $"El parque '{_modelo.Nombre}' se modificó correctamente."
            });

            NavigationManager.NavigateTo("/parques");
        }
        catch (ParqueNoEncontradoException excepcion)
        {
            NotificarError(excepcion.Message);
        }
        catch (ParqueNombreDuplicadoException excepcion)
        {
            NotificarError(excepcion.Message);
        }
        catch (ParqueInvalidoException excepcion)
        {
            NotificarError(excepcion.Message);
        }
        catch (UsuarioNoAutorizadoException excepcion)
        {
            NotificarError(excepcion.Message);
        }
        catch (ValidationException excepcion)
        {
            NotificarError(string.Join(" ", excepcion.Errors.Select(error => error.ErrorMessage)));
        }
    }

    private void NotificarError(string detalle)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "No se pudo modificar el parque",
            Detail = detalle
        });
    }
}
