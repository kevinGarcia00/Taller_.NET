@page "/parques/{ParqueId:int}/nodos/alta"
@page "/nodos/alta"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@inject INodoService NodoService
@inject IParqueService ParqueService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Alta de Nodo</PageTitle>

<h1>Alta de Nodo</h1>

<AuthorizeView Roles="Administrador" Context="autorizacion">
    <Authorized>
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="Parque solar" Variant="Variant.Outlined">
                    @if (EsAltaContextual)
                    {
                        <RadzenTextBox Value="@_nombreParque" ReadOnly="true" />
                    }
                    else
                    {
                        <RadzenDropDown TValue="int?" Data="@_parques" @bind-Value="_parqueSeleccionadoId"
                                        TextProperty="Nombre" ValueProperty="Id"
                                        Placeholder="Seleccione un parque" />
                    }
                </RadzenFormField>

                <RadzenTemplateForm TItem="CrearNodoDto" Data="@_modelo" Submit="OnValidSubmit">
                    <RadzenStack Gap="1rem">
                        <RadzenFormField Text="Nombre" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_modelo.Nombre" MaxLength="@Nodo.LongitudMaximaNombre" />
                        </RadzenFormField>

                        <RadzenFormField Text="Ubicacion en el parque" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_modelo.UbicacionParque" MaxLength="@Nodo.LongitudMaximaUbicacionParque" />
                        </RadzenFormField>

                        <RadzenFormField Text="Inversor (opcional)" Variant="Variant.Outlined">
                            <RadzenDropDown TValue="int?" Data="@_inversores" @bind-Value="_modelo.InversorId"
                                            TextProperty="Nombre" ValueProperty="Id" AllowClear="true"
                                            Placeholder="Sin inversor asignado" />
                        </RadzenFormField>

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Text="Registrar nodo" ButtonType="ButtonType.Submit" Icon="add_circle_outline" />
                            <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Secondary" Icon="cancel"
                                          Click="@Cancelar" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenStack>
        </RadzenCard>
    </Authorized>
    <NotAuthorized>
        <RadzenAlert AlertStyle="AlertStyle.Warning" Title="Acceso restringido">
            Solo los usuarios con el rol de Administrador pueden registrar nodos.
        </RadzenAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public int ParqueId { get; set; }

    private CrearNodoDto _modelo = new();
    private IReadOnlyList<InversorDisponibleDto> _inversores = new List<InversorDisponibleDto>();
    private IReadOnlyList<ParqueListadoDto> _parques = new List<ParqueListadoDto>();
    private int? _parqueSeleccionadoId;
    private string _nombreParque = string.Empty;

    private bool EsAltaContextual => ParqueId > 0;

    protected override async Task OnInitializedAsync()
    {
        if (EsAltaContextual)
        {
            _parqueSeleccionadoId = ParqueId;
            _nombreParque = ObtenerNombreParque();
        }
        else
        {
            CargarParques();
        }

        await CargarInversoresAsync();
    }

    private void CargarParques()
    {
        try
        {
            _parques = ParqueService.ObtenerParquesSync();
        }
        catch (System.Exception excepcion)
        {
            NotificarError("No se pudieron obtener los parques", excepcion.Message);
        }
    }

    private async Task CargarInversoresAsync()
    {
        try
        {
            _inversores = await NodoService.ObtenerInversoresDisponiblesAsync();
        }
        catch (System.Exception excepcion)
        {
            NotificarError("No se pudieron obtener los inversores disponibles", excepcion.Message);
        }
    }

    private string ObtenerNombreParque()
    {
        try
        {
            return ParqueService.ObtenerParqueSync(ParqueId).Nombre;
        }
        catch (ParqueNoEncontradoException excepcion)
        {
            NotificarError("No se pudo obtener el parque", excepcion.Message);
            return string.Empty;
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo(EsAltaContextual ? $"/parques/{ParqueId}" : "/parques");
    }

    private async Task OnValidSubmit()
    {
        _modelo.ParqueSolarId = _parqueSeleccionadoId ?? 0;

        if (_modelo.ParqueSolarId <= 0)
        {
            NotificarError("No se pudo registrar el nodo", "Debe seleccionar un parque solar.");
            return;
        }

        try
        {
            await NodoService.CrearNodoAsync(_modelo);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Nodo registrado",
                Detail = $"El nodo '{_modelo.Nombre}' se registro correctamente."
            });

            NavigationManager.NavigateTo($"/parques/{_modelo.ParqueSolarId}/nodos");
        }
        catch (NodoNombreDuplicadoException excepcion)
        {
            NotificarError("No se pudo registrar el nodo", excepcion.Message);
        }
        catch (ParqueNoEncontradoException excepcion)
        {
            NotificarError("No se pudo registrar el nodo", excepcion.Message);
        }
        catch (InversorNoEncontradoException excepcion)
        {
            NotificarError("No se pudo registrar el nodo", excepcion.Message);
        }
        catch (InversorYaAsignadoException excepcion)
        {
            NotificarError("No se pudo registrar el nodo", excepcion.Message);
        }
        catch (UsuarioNoAutorizadoException excepcion)
        {
            NotificarError("No se pudo registrar el nodo", excepcion.Message);
        }
        catch (FluentValidation.ValidationException excepcion)
        {
            NotificarError("No se pudo registrar el nodo", excepcion.Message);
        }
    }

    private void NotificarError(string resumen, string detalle)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = resumen,
            Detail = detalle
        });
    }
}
