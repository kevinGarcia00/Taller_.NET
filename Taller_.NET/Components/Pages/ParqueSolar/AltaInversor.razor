@page "/parques/{ParqueId:int}/nodos/{NodoId:int}/inversor/alta"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using Taller_.NET.Modulos.ParqueSolar.Domain.Excepciones
@inject IInversorService InversorService
@inject INodoService NodoService
@inject IParqueService ParqueService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Alta de Inversor</PageTitle>

<h1>Alta de Inversor</h1>

<AuthorizeView Roles="Administrador" Context="autorizacion">
    <Authorized>
        @if (_mostrarFormulario)
        {
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="Parque solar" Variant="Variant.Outlined">
                        <RadzenTextBox Value="@_nombreParque" ReadOnly="true" />
                    </RadzenFormField>

                    <RadzenFormField Text="Nodo" Variant="Variant.Outlined">
                        <RadzenTextBox Value="@_nombreNodo" ReadOnly="true" />
                    </RadzenFormField>

                    <RadzenTemplateForm TItem="CrearInversorDto" Data="@_modelo" Submit="OnValidSubmit">
                        <RadzenStack Gap="1rem">
                            <RadzenFormField Text="Nombre" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="_modelo.Nombre" MaxLength="@Inversor.LongitudMaximaNombre" />
                            </RadzenFormField>

                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton Text="Registrar inversor" ButtonType="ButtonType.Submit" Icon="add_circle_outline" />
                                <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Secondary" Icon="cancel"
                                              Click="@Cancelar" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenTemplateForm>
                </RadzenStack>
            </RadzenCard>
        }
    </Authorized>
    <NotAuthorized>
        <RadzenAlert AlertStyle="AlertStyle.Warning" Title="Acceso restringido">
            Solo los usuarios con el rol de Administrador pueden registrar inversores.
        </RadzenAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public int ParqueId { get; set; }

    [Parameter]
    public int NodoId { get; set; }

    private CrearInversorDto _modelo = new();
    private string _nombreParque = string.Empty;
    private string _nombreNodo = string.Empty;
    private bool _mostrarFormulario;

    protected override async Task OnInitializedAsync()
    {
        _modelo.ParqueSolarId = ParqueId;
        _modelo.NodoId = NodoId;
        _nombreParque = ObtenerNombreParque();
        await PrepararAltaAsync();
    }

    private string ObtenerNombreParque()
    {
        try
        {
            return ParqueService.ObtenerParqueSync(ParqueId).Nombre;
        }
        catch (ParqueNoEncontradoException excepcion)
        {
            NotificarError("No se pudo obtener el parque", excepcion.Message);
            return string.Empty;
        }
    }

    private async Task PrepararAltaAsync()
    {
        try
        {
            var nodo = await NodoService.ObtenerNodoParaEdicionAsync(NodoId, ParqueId);
            _nombreNodo = nodo.Nombre;

            if (nodo.InversorId.HasValue)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "El nodo ya tiene un inversor",
                    Detail = "No se puede registrar un segundo inversor para este nodo."
                });

                NavigationManager.NavigateTo($"/parques/{ParqueId}/nodos/{NodoId}/inversor");
                return;
            }

            _mostrarFormulario = true;
        }
        catch (NodoNoEncontradoException excepcion)
        {
            NotificarError("No se pudo obtener el nodo", excepcion.Message);
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo($"/parques/{ParqueId}/nodos");
    }

    private async Task OnValidSubmit()
    {
        _modelo.ParqueSolarId = ParqueId;
        _modelo.NodoId = NodoId;

        try
        {
            await InversorService.CrearInversorAsync(_modelo);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Inversor registrado",
                Detail = $"El inversor '{_modelo.Nombre}' se registro correctamente."
            });

            NavigationManager.NavigateTo($"/parques/{ParqueId}/nodos/{NodoId}/inversor");
        }
        catch (NodoYaTieneInversorException excepcion)
        {
            NotificarError("No se pudo registrar el inversor", excepcion.Message);
            NavigationManager.NavigateTo($"/parques/{ParqueId}/nodos/{NodoId}/inversor");
        }
        catch (NodoNoEncontradoException excepcion)
        {
            NotificarError("No se pudo registrar el inversor", excepcion.Message);
        }
        catch (UsuarioNoAutorizadoException excepcion)
        {
            NotificarError("No se pudo registrar el inversor", excepcion.Message);
        }
        catch (InversorInvalidoException excepcion)
        {
            NotificarError("No se pudo registrar el inversor", excepcion.Message);
        }
        catch (FluentValidation.ValidationException excepcion)
        {
            NotificarError("No se pudo registrar el inversor", excepcion.Message);
        }
    }

    private void NotificarError(string resumen, string detalle)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = resumen,
            Detail = detalle
        });
    }
}
