@page "/parques/{ParqueId:int}/nodos/{NodoId:int}/paneles/{PanelId:int}/mantenibilidad/alta"
@using Taller_.NET.Modulos.Historico.Application.Excepciones
@using Taller_.NET.Modulos.Historico.Domain.Excepciones
@using UsuarioNoAutorizadoException = Taller_.NET.Modulos.Historico.Application.Excepciones.UsuarioNoAutorizadoException
@attribute [Authorize(Roles = "Mantenimiento")]
@rendermode InteractiveServer
@inject IHistoricoMantenibilidadService HistoricoService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Alta de mantenibilidad</PageTitle>

<h1>Alta de mantenibilidad</h1>

<AuthorizeView Roles="Mantenimiento" Context="autorizacion">
    <Authorized>
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="Parque solar" Variant="Variant.Outlined">
                    <RadzenTextBox Value="@_contexto?.NombreParque" ReadOnly="true" />
                </RadzenFormField>
                <RadzenFormField Text="Nodo" Variant="Variant.Outlined">
                    <RadzenTextBox Value="@_contexto?.NombreNodo" ReadOnly="true" />
                </RadzenFormField>
                <RadzenFormField Text="Panel" Variant="Variant.Outlined">
                    <RadzenTextBox Value="@_contexto?.NombrePanel" ReadOnly="true" />
                </RadzenFormField>

                <RadzenTemplateForm TItem="CrearHistoricoMantenibilidadDto" Data="@_modelo" Submit="OnValidSubmit">
                    <RadzenStack Gap="1rem">
                        <RadzenFormField Text="Usuario de mantenimiento" Variant="Variant.Outlined">
                            <RadzenTextBox Value="@_nombreMantenedor" ReadOnly="true" />
                        </RadzenFormField>

                        <RadzenFormField Text="Fecha" Variant="Variant.Outlined">
                            <RadzenDatePicker TValue="DateTime" @bind-Value="_modelo.Fecha" DateFormat="dd/MM/yyyy" Max="@DateTime.Today" />
                        </RadzenFormField>

                        <RadzenFormField Text="Estado resultante" Variant="Variant.Outlined">
                            <RadzenDropDown TValue="EstadoPanelRegistrado" Data="@_estados" @bind-Value="_modelo.EstadoResultante"
                                            Placeholder="Seleccione un estado" />
                        </RadzenFormField>

                        <RadzenFormField Text="Observaciones" Variant="Variant.Outlined">
                            <RadzenTextArea @bind-Value="_modelo.Observaciones" Rows="4" MaxLength="@HistoricoMantenibilidad.LongitudMaximaObservaciones" />
                        </RadzenFormField>

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Text="Registrar" ButtonType="ButtonType.Submit" Icon="add_circle_outline"
                                          Disabled="@(_contexto is null || _modelo.IdMantenedor == Guid.Empty)" />
                            <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Secondary" Icon="cancel" Click="@VolverAlPanel" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenTemplateForm>
            </RadzenStack>
        </RadzenCard>
    </Authorized>
    <NotAuthorized>
        <RadzenAlert AlertStyle="AlertStyle.Warning" Title="Acceso restringido">
            Solo los usuarios con el rol de Mantenimiento pueden registrar un mantenimiento.
        </RadzenAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public int ParqueId { get; set; }

    [Parameter]
    public int NodoId { get; set; }

    [Parameter]
    public int PanelId { get; set; }

    private CrearHistoricoMantenibilidadDto _modelo = new() { Fecha = DateTime.Today };
    private ContextoPanelLecturaDto? _contexto;
    private string _nombreMantenedor = string.Empty;
    private readonly IReadOnlyList<EstadoPanelRegistrado> _estados = Enum.GetValues<EstadoPanelRegistrado>();

    protected override async Task OnInitializedAsync()
    {
        _modelo.PanelId = PanelId;
        _modelo.NodoId = NodoId;
        _modelo.ParqueSolarId = ParqueId;

        try
        {
            _contexto = await HistoricoService.ObtenerContextoPanelAsync(PanelId, NodoId, ParqueId);
            var mantenedor = await HistoricoService.ObtenerMantenedorDeSesionAsync();
            _modelo.IdMantenedor = mantenedor.Id;
            _nombreMantenedor = mantenedor.Nombre;
        }
        catch (PanelFueraDeContextoException excepcion)
        {
            NotificarError("No se pudo abrir el alta", excepcion.Message);
        }
        catch (System.Exception excepcion)
        {
            NotificarError("No se pudo abrir el alta", excepcion.Message);
        }
    }

    private async Task OnValidSubmit()
    {
        _modelo.PanelId = PanelId;
        _modelo.NodoId = NodoId;
        _modelo.ParqueSolarId = ParqueId;

        try
        {
            await HistoricoService.RegistrarRegistroAsync(_modelo);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Mantenimiento registrado",
                Detail = "El registro de mantenibilidad se guardo correctamente."
            });

            NavigationManager.NavigateTo($"/parques/{ParqueId}/nodos/{NodoId}/paneles/{PanelId}/mantenibilidad");
        }
        catch (PanelFueraDeContextoException excepcion)
        {
            NotificarError("No se pudo registrar el mantenimiento", excepcion.Message);
        }
        catch (MantenedorNoEncontradoException excepcion)
        {
            NotificarError("No se pudo registrar el mantenimiento", excepcion.Message);
        }
        catch (MantenedorSinRolException excepcion)
        {
            NotificarError("No se pudo registrar el mantenimiento", excepcion.Message);
        }
        catch (UsuarioNoAutorizadoException excepcion)
        {
            NotificarError("No se pudo registrar el mantenimiento", excepcion.Message);
        }
        catch (FluentValidation.ValidationException excepcion)
        {
            NotificarError("No se pudo registrar el mantenimiento", excepcion.Message);
        }
        catch (HistoricoMantenibilidadInvalidoException excepcion)
        {
            NotificarError("No se pudo registrar el mantenimiento", excepcion.Message);
        }
    }

    private void VolverAlPanel()
    {
        NavigationManager.NavigateTo($"/parques/{ParqueId}/nodos/{NodoId}/paneles/{PanelId}");
    }

    private void NotificarError(string resumen, string detalle)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = resumen,
            Detail = detalle
        });
    }
}
